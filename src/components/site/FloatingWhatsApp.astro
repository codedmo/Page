---
import { MessageCircle } from 'lucide-react';
import { contactInfo } from '../../data/site';
---

<div class="pointer-events-none fixed bottom-5 right-4 z-50">
  <a
    href={contactInfo.whatsappHref}
    target="_blank"
    rel="noreferrer"
    aria-label={contactInfo.whatsappLabel}
    class="pointer-events-auto inline-flex max-w-[calc(100vw-2rem)] items-center gap-2 rounded-full border border-emerald-400/20 bg-[linear-gradient(135deg,rgba(6,78,59,0.88),rgba(6,95,70,0.84))] px-2.5 py-2.5 text-emerald-50 shadow-[0_12px_30px_rgba(4,47,46,0.26)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-emerald-300/35 hover:bg-[linear-gradient(135deg,rgba(6,78,59,0.94),rgba(5,120,87,0.9))]"
  >
    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/8">
      <MessageCircle class="h-4.5 w-4.5" />
    </span>
    <span class="hidden sm:block">
      <span class="block text-[10px] font-semibold uppercase tracking-[0.22em] text-emerald-200/65">
        Contacto
      </span>
      <span class="mt-0.5 block text-sm font-medium leading-tight">WhatsApp</span>
    </span>
  </a>
</div>
