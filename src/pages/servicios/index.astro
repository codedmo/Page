---
import { serviceCategories } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const canonical = 'https://codedmo.dev/servicios';
---

<BaseLayout
  currentPath="/servicios"
  title="Servicios | CODEDMO"
  description="Desarrollo web, software a medida, hosting, productividad empresarial y herramientas de cotización."
  canonical={canonical}
  keywords={['servicios tecnológicos', 'desarrollo web', 'software a medida', 'hosting', 'workspace', 'microsoft 365']}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Servicios CODEDMO',
    url: canonical,
    description: 'Catálogo de servicios de CODEDMO.',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: serviceCategories.map((category, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `https://codedmo.dev${category.href}`,
        name: category.label,
        description: category.description,
      })),
    },
  }}
>
  <section class="page-fill page-fill-shell relative overflow-hidden bg-gradient-to-br from-slate-950 via-blue-950 to-slate-950 py-20">
    <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[size:32px_32px]" aria-hidden="true"></div>
    <div class="absolute left-1/4 top-20 h-96 w-96 rounded-full bg-blue-500/10 blur-3xl" aria-hidden="true"></div>
    <div class="absolute bottom-0 right-1/4 h-80 w-80 rounded-full bg-cyan-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="page-fill-container relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-black text-white sm:text-6xl">
          Soluciones <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">Tecnológicas</span>
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-300">
          Servicios diseñados para resolver crecimiento, operación y presencia digital con una oferta
          clara, mantenible y enfocada en resultados.
        </p>
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-2 xl:grid-cols-4">
        {
          serviceCategories.map((category) => (
            <a
              href={category.href}
              class="group rounded-[2rem] border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/10"
            >
              <div class={`h-1 w-20 rounded-full bg-gradient-to-r ${category.accent}`}></div>
              <h2 class="mt-6 text-2xl font-bold text-white">{category.label}</h2>
              <p class="mt-3 min-h-20 text-sm leading-7 text-slate-300">{category.description}</p>
              <ul class="mt-5 space-y-3 text-sm text-slate-200">
                {
                  category.items.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-1.5 w-1.5 rounded-full bg-blue-400"></span>
                      <span>{item.label}</span>
                    </li>
                  ))
                }
              </ul>
              <div class="mt-6 border-t border-white/10 pt-4 text-sm font-semibold text-cyan-200">
                Explorar categoría →
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-16 rounded-[2rem] border border-white/10 bg-white/5 p-8 text-center backdrop-blur-sm">
        <h2 class="text-2xl font-bold text-white">¿No tienes claro el siguiente paso?</h2>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-slate-300">
          Empezamos por alcance, restricción técnica y prioridad de negocio. A partir de ahí definimos
          servicio, ruta y ritmo realista.
        </p>
        <a
          href="/servicios/cotizacion/consulta"
          class="mt-6 inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-blue-600 to-cyan-600 px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:scale-[1.02] hover:shadow-xl hover:shadow-blue-500/20"
        >
          Solicitar consulta gratuita
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
