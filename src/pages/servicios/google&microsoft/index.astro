---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const canonical = 'https://codedmo.dev/servicios/google&microsoft';
const services = [
  {
    href: '/servicios/google&microsoft/workspace',
    title: 'Google Workspace',
    description: 'Correo, archivos, colaboración y administración para equipos que necesitan orden.',
    features: ['Gmail empresarial', 'Drive', 'Meet', 'Controles administrativos'],
  },
  {
    href: '/servicios/google&microsoft/microsoft365',
    title: 'Microsoft 365',
    description: 'Office, Teams y productividad empresarial con configuración y soporte adecuados.',
    features: ['Teams', 'OneDrive', 'SharePoint', 'Seguridad empresarial'],
  },
];

const integrations = [
  'Migración de correo y archivos',
  'Políticas de acceso y seguridad',
  'Automatización entre suites y sistemas internos',
  'Capacitación operativa para el equipo',
];
---

<BaseLayout
  currentPath="/servicios/google&microsoft"
  title="Google & Microsoft | CODEDMO"
  description="Implementación, migración e integración de Google Workspace y Microsoft 365."
  canonical={canonical}
  keywords={['google workspace', 'microsoft 365', 'migración de correo', 'productividad empresarial']}
>
  <section class="page-fill page-fill-shell relative overflow-hidden bg-slate-950 py-20">
    <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:32px_32px]" aria-hidden="true"></div>

    <div class="page-fill-container relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-black text-white sm:text-6xl">
          Google & <span class="bg-gradient-to-r from-indigo-400 to-violet-400 bg-clip-text text-transparent">Microsoft</span>
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-300">
          Implementamos suites de productividad y las conectamos con la operación real de tu empresa.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {
          services.map((service) => (
            <a
              href={service.href}
              class="rounded-[2rem] border border-white/10 bg-white/5 p-7 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/10"
            >
              <h2 class="text-2xl font-bold text-white">{service.title}</h2>
              <p class="mt-3 text-sm leading-7 text-slate-300">{service.description}</p>
              <ul class="mt-5 space-y-3 text-sm text-slate-200">
                {service.features.map((feature) => <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-indigo-400"></span><span>{feature}</span></li>)}
              </ul>
            </a>
          ))
        }
      </div>

      <div class="mt-10 rounded-[2rem] border border-white/10 bg-white/5 p-8 backdrop-blur-sm">
        <h2 class="text-2xl font-bold text-white">Integraciones y acompañamiento</h2>
        <ul class="mt-5 grid gap-4 md:grid-cols-2">
          {integrations.map((item) => <li class="flex gap-3 text-sm leading-7 text-slate-300"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-indigo-400"></span><span>{item}</span></li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
