---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const canonical = 'https://codedmo.dev/servicios/cotizacion';
const options = [
  {
    href: '/servicios/cotizacion/consulta',
    title: 'Consulta Gratuita',
    description: 'Revisión técnica sin costo para aterrizar alcance, restricciones y siguiente paso.',
    accent: 'from-fuchsia-500 to-pink-500',
    features: ['Videollamada o contacto directo', 'Recomendaciones técnicas', 'Plan de acción inicial'],
  },
  {
    href: '/servicios/cotizacion/estimacion',
    title: 'Estimación Rápida',
    description: 'Herramientas para aproximar costo, tiempo y tradeoffs antes de entrar a una propuesta formal.',
    accent: 'from-cyan-500 to-blue-500',
    features: ['Cotizador interactivo', 'Triángulo de hierro', 'Escenarios comparables'],
  },
];

const benefits = [
  {
    title: 'Sin costo ni compromiso',
    description: 'La idea es darte claridad inicial, no empujarte a una venta prematura.',
  },
  {
    title: 'Respuesta rápida',
    description: 'Priorizamos contexto, alcance y riesgos para avanzar con criterio.',
  },
  {
    title: 'Enfoque técnico y de negocio',
    description: 'No solo cotizamos tareas; definimos impacto, prioridad y secuencia realista.',
  },
];

const process = [
  ['01', 'Compartes contexto', 'Objetivo, necesidad, restricciones y cualquier referencia útil.'],
  ['02', 'Ordenamos alcance', 'Separamos requerimientos reales de supuestos o ruido.'],
  ['03', 'Definimos ruta', 'Consulta, estimación o propuesta formal según complejidad.'],
  ['04', 'Ejecutamos siguiente paso', 'Agendamos reunión o te dejamos una base clara para decidir.'],
];
---

<BaseLayout
  currentPath="/servicios/cotizacion"
  title="Cotización de Proyectos | CODEDMO"
  description="Consulta gratuita y herramientas de estimación para definir alcance, costo y siguiente paso de tu proyecto."
  canonical={canonical}
  keywords={['cotización de proyectos', 'consulta técnica', 'estimación rápida', 'presupuesto software', 'CODEDMO']}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Cotización de proyectos CODEDMO',
    url: canonical,
    description: 'Consulta gratuita y estimación rápida para proyectos digitales.',
  }}
>
  <section class="page-fill relative overflow-hidden bg-gradient-to-br from-slate-950 via-fuchsia-950/60 to-slate-950 py-20">
    <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:32px_32px]" aria-hidden="true"></div>
    <div class="absolute left-1/4 top-10 h-80 w-80 rounded-full bg-fuchsia-500/10 blur-3xl" aria-hidden="true"></div>
    <div class="absolute bottom-0 right-1/4 h-80 w-80 rounded-full bg-cyan-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-black text-white sm:text-6xl">
          Cotización y <span class="bg-gradient-to-r from-fuchsia-400 to-cyan-400 bg-clip-text text-transparent">Planeación</span>
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-300">
          Elige entre una consulta gratuita o una estimación rápida para aterrizar alcance, tiempo y
          prioridades antes de comprometer presupuesto.
        </p>
      </div>

      <div class="mt-14 grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="rounded-[2rem] border border-white/10 bg-white/5 p-8 backdrop-blur-sm">
          <h2 class="text-2xl font-bold text-white">Qué obtienes</h2>
          <div class="mt-6 space-y-5">
            {
              benefits.map((benefit) => (
                <article class="rounded-2xl border border-white/10 bg-slate-950/50 p-5">
                  <h3 class="text-lg font-semibold text-white">{benefit.title}</h3>
                  <p class="mt-2 text-sm leading-7 text-slate-300">{benefit.description}</p>
                </article>
              ))
            }
          </div>
          <a
            href="/contacto"
            class="mt-8 inline-flex items-center justify-center rounded-xl border border-white/15 px-5 py-3 text-sm font-semibold text-white transition-all duration-300 hover:border-white/30 hover:bg-white/10"
          >
            Hablar con nosotros
          </a>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          {
            options.map((option) => (
              <a
                href={option.href}
                class="group rounded-[2rem] border border-white/10 bg-white/5 p-7 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/10"
              >
                <div class={`h-1 w-20 rounded-full bg-gradient-to-r ${option.accent}`}></div>
                <h2 class="mt-6 text-2xl font-bold text-white">{option.title}</h2>
                <p class="mt-3 text-sm leading-7 text-slate-300">{option.description}</p>
                <ul class="mt-5 space-y-3 text-sm text-slate-200">
                  {
                    option.features.map((feature) => (
                      <li class="flex gap-3">
                        <span class="mt-2 h-1.5 w-1.5 rounded-full bg-fuchsia-400"></span>
                        <span>{feature}</span>
                      </li>
                    ))
                  }
                </ul>
                <div class="mt-6 border-t border-white/10 pt-4 text-sm font-semibold text-cyan-200">
                  Abrir opción →
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <div class="mt-16 rounded-[2rem] border border-white/10 bg-white/5 p-8 backdrop-blur-sm">
        <h2 class="text-2xl font-bold text-white">Cómo trabajamos esta etapa</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-4">
          {
            process.map(([step, title, description]) => (
              <article class="rounded-2xl border border-white/10 bg-slate-950/50 p-5">
                <div class="text-sm font-semibold tracking-[0.25em] text-fuchsia-300">{step}</div>
                <h3 class="mt-3 text-lg font-semibold text-white">{title}</h3>
                <p class="mt-2 text-sm leading-7 text-slate-300">{description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
