---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const canonical = 'https://codedmo.dev/servicios/desarrollo';
const services = [
  {
    href: '/servicios/desarrollo/web',
    title: 'Desarrollo Web',
    description: 'Sitios, landing pages, e-commerce y plataformas enfocadas en rendimiento y conversión.',
    features: ['React y Next.js', 'SEO técnico', 'Responsive real', 'Arquitectura clara'],
  },
  {
    href: '/servicios/desarrollo/software',
    title: 'Software a Medida',
    description: 'Sistemas internos, automatización, operaciones y flujos personalizados para tu negocio.',
    features: ['ERP/CRM', 'Integración de procesos', 'Escalabilidad', 'Soporte continuo'],
  },
  {
    href: '/servicios/desarrollo/movil',
    title: 'Apps Móviles',
    description: 'Experiencias móviles pensadas para adopción, claridad de flujo y crecimiento.',
    features: ['iOS y Android', 'UX enfocada', 'Notificaciones', 'Offline-first'],
  },
  {
    href: '/servicios/desarrollo/api',
    title: 'APIs e Integraciones',
    description: 'Conectamos sistemas, automatizamos tareas y diseñamos capas de integración estables.',
    features: ['REST y GraphQL', 'Webhooks', 'Integraciones legacy', 'Documentación'],
  },
];
---

<BaseLayout
  currentPath="/servicios/desarrollo"
  title="Desarrollo | CODEDMO"
  description="Desarrollo web, software a medida, apps móviles y APIs con foco en claridad técnica y velocidad de entrega."
  canonical={canonical}
  keywords={['desarrollo web', 'software a medida', 'apps móviles', 'APIs', 'automatización']}
>
  <section class="relative overflow-hidden bg-slate-950 py-20">
    <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[size:32px_32px]" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-black text-white sm:text-6xl">
          Desarrollo <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">de Software</span>
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-300">
          Elegimos la forma correcta de construir según el problema real, no por moda ni exceso de
          stack.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {
          services.map((service) => (
            <a
              href={service.href}
              class="rounded-[2rem] border border-white/10 bg-white/5 p-7 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/10"
            >
              <h2 class="text-2xl font-bold text-white">{service.title}</h2>
              <p class="mt-3 text-sm leading-7 text-slate-300">{service.description}</p>
              <ul class="mt-5 space-y-3 text-sm text-slate-200">
                {service.features.map((feature) => <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-blue-400"></span><span>{feature}</span></li>)}
              </ul>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
