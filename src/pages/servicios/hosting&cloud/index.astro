---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const canonical = 'https://codedmo.dev/servicios/hosting&cloud';
const services = [
  {
    href: '/servicios/hosting&cloud/hosting',
    title: 'Hosting Profesional',
    description: 'Alojamiento seguro y administrado para sitios, tiendas y aplicaciones.',
    features: ['SSL', 'Backup diario', 'Soporte técnico', 'Panel de administración'],
  },
  {
    href: '/servicios/hosting&cloud/cloud',
    title: 'Servicios Cloud',
    description: 'Infraestructura preparada para crecer, desplegar y operar con menos fricción.',
    features: ['Escalabilidad', 'Observabilidad', 'Automatización', 'Entornos reproducibles'],
  },
  {
    href: '/servicios/hosting&cloud/dominios',
    title: 'Dominios y DNS',
    description: 'Registro, gestión de DNS y continuidad operativa para la presencia digital de tu marca.',
    features: ['DNS administrado', 'Renovación', 'Seguridad', 'Soporte'],
  },
];
---

<BaseLayout
  currentPath="/servicios/hosting&cloud"
  title="Hosting & Cloud | CODEDMO"
  description="Hosting administrado, servicios cloud y gestión de dominios para proyectos con foco en estabilidad."
  canonical={canonical}
  keywords={['hosting profesional', 'cloud', 'dominios', 'infraestructura web']}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Hosting y Cloud CODEDMO',
    url: canonical,
    description: 'Servicios de hosting administrado, cloud y dominios.',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: services.map((service, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `https://codedmo.dev${service.href}`,
        name: service.title,
        description: service.description,
      })),
    },
  }}
>
  <section class="page-fill page-fill-shell relative overflow-hidden bg-slate-950 py-20">
    <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:32px_32px]" aria-hidden="true"></div>

    <div class="page-fill-container relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-black text-white sm:text-6xl">
          Hosting & <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">Cloud</span>
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-300">
          Infraestructura clara y estable para que tu producto funcione bien hoy y no se convierta en
          deuda operativa mañana.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {
          services.map((service) => (
            <a
              href={service.href}
              class="rounded-[2rem] border border-white/10 bg-white/5 p-7 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/10"
            >
              <h2 class="text-2xl font-bold text-white">{service.title}</h2>
              <p class="mt-3 text-sm leading-7 text-slate-300">{service.description}</p>
              <ul class="mt-5 space-y-3 text-sm text-slate-200">
                {service.features.map((feature) => <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-emerald-400"></span><span>{feature}</span></li>)}
              </ul>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
