---
import BaseLayout from '../layouts/BaseLayout.astro';

const canonical = 'https://codedmo.dev/politicas';
const sections = [
  {
    title: 'Privacidad',
    content: [
      'Recopilamos únicamente información necesaria para comunicación, facturación, soporte y ejecución de proyectos.',
      'Aplicamos cifrado en tránsito, controles de acceso y procesos de respaldo cuando corresponde.',
      'No compartimos datos con terceros salvo obligación legal o necesidad operativa informada.',
    ],
  },
  {
    title: 'Términos de servicio',
    content: [
      'Las propuestas tienen vigencia limitada y el proyecto inicia al confirmar alcance, anticipo y material base.',
      'Los cambios de alcance se evalúan por separado y pueden modificar plazo o presupuesto.',
      'El trabajo puede pausarse si falta información crítica o si existen pagos pendientes fuera del acuerdo.',
    ],
  },
  {
    title: 'Propiedad intelectual',
    content: [
      'Los entregables se transfieren al cliente al completar el pago acordado.',
      'CODEDMO conserva metodologías, patrones internos y know-how general no confidencial.',
      'Las propuestas no aceptadas siguen siendo propiedad de CODEDMO.',
    ],
  },
  {
    title: 'Garantías y soporte',
    content: [
      'Ofrecemos una garantía posterior a entrega para corregir defectos dentro del alcance definido.',
      'El mantenimiento continuo y nuevas funcionalidades se cotizan como soporte recurrente o evolución del producto.',
      'Integraciones con terceros dependen también de la disponibilidad y cambios del proveedor externo.',
    ],
  },
];
---

<BaseLayout
  currentPath="/politicas"
  title="Políticas | CODEDMO"
  description="Políticas de privacidad, términos de servicio, garantías y lineamientos legales de CODEDMO."
  canonical={canonical}
  keywords={['política de privacidad', 'términos de servicio', 'garantías software', 'CODEDMO']}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Políticas CODEDMO',
    url: canonical,
    description: 'Políticas y términos de CODEDMO.',
  }}
>
  <section class="relative overflow-hidden bg-slate-950 py-20">
    <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:34px_34px]" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-black text-white sm:text-6xl">Políticas y Términos</h1>
        <p class="mt-6 text-lg leading-8 text-slate-300">
          Resumen operativo de cómo tratamos datos, acordamos proyectos, transferimos entregables y
          manejamos soporte.
        </p>
      </div>

      <div class="mt-14 grid gap-6">
        {
          sections.map((section) => (
            <article class="rounded-[2rem] border border-white/10 bg-white/5 p-8 backdrop-blur-sm">
              <h2 class="text-2xl font-bold text-white">{section.title}</h2>
              <ul class="mt-5 space-y-3 text-sm leading-7 text-slate-300">
                {section.content.map((item) => <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-blue-400"></span><span>{item}</span></li>)}
              </ul>
            </article>
          ))
        }

        <article class="rounded-[2rem] border border-white/10 bg-white/5 p-8 backdrop-blur-sm">
          <h2 class="text-2xl font-bold text-white">Contacto legal</h2>
          <div class="mt-5 space-y-2 text-sm leading-7 text-slate-300">
            <p><strong>Email:</strong> legal@codedmo.dev</p>
            <p><strong>Teléfono:</strong> +502 3792 3612</p>
            <p><strong>Dirección:</strong> Ciudad de Guatemala, Guatemala</p>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
