---
import BaseLayout from '../layouts/BaseLayout.astro';

const canonical = 'https://codedmo.dev/about';
const values = [
  ['Excelencia', 'Diseñamos soluciones robustas, legibles y preparadas para mantenerse en el tiempo.'],
  ['Confiabilidad', 'Operamos con foco en seguridad, estabilidad y comunicación directa.'],
  ['Colaboración', 'Trabajamos junto al cliente, no detrás de una caja negra.'],
  ['Resultados', 'Cada decisión técnica debe empujar una métrica de negocio u operación.'],
];
---

<BaseLayout
  currentPath="/about"
  title="Nosotros | CODEDMO"
  description="Conoce la visión, el enfoque y los principios con los que CODEDMO diseña y desarrolla productos digitales."
  canonical={canonical}
  keywords={['empresa de software Guatemala', 'equipo de desarrollo', 'CODEDMO', 'desarrollo web profesional']}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Acerca de CODEDMO',
    url: canonical,
    description: 'Visión, misión y valores de CODEDMO.',
  }}
>
  <section class="page-fill page-fill-shell relative overflow-hidden bg-slate-950 py-20">
    <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:34px_34px]" aria-hidden="true"></div>
    <div class="absolute right-1/4 top-0 h-96 w-96 rounded-full bg-blue-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="page-fill-container relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-black text-white sm:text-6xl">
          Acerca de <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">Nosotros</span>
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-300">
          Somos una empresa guatemalteca dedicada a construir productos digitales claros, rápidos y
          sostenibles para equipos que necesitan ejecutar con orden técnico y visión de negocio.
        </p>
      </div>

      <div class="mt-14 grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="space-y-8">
          <article class="rounded-[2rem] border border-white/10 bg-white/5 p-8 backdrop-blur-sm">
            <h2 class="text-2xl font-bold text-white">Nuestra misión</h2>
            <p class="mt-4 text-base leading-8 text-slate-300">
              Empoderar a empresas y equipos mediante software, automatización e infraestructura que
              reduzcan fricción operativa y mejoren la velocidad con la que convierten oportunidades
              en resultados.
            </p>
          </article>

          <article class="rounded-[2rem] border border-white/10 bg-white/5 p-8 backdrop-blur-sm">
            <h2 class="text-2xl font-bold text-white">Nuestra visión</h2>
            <p class="mt-4 text-base leading-8 text-slate-300">
              Convertirnos en el socio técnico de referencia para negocios que necesitan claridad,
              criterio y ejecución consistente, sin inflar complejidad ni procesos innecesarios.
            </p>
          </article>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
          {
            values.map(([title, description]) => (
              <article class="rounded-[2rem] border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
                <h3 class="text-xl font-bold text-white">{title}</h3>
                <p class="mt-3 text-sm leading-7 text-slate-300">{description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
