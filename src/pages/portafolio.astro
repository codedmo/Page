---
import { portfolioProjects } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const canonical = 'https://codedmo.dev/portafolio';
const sortedProjects = [...portfolioProjects].sort((a, b) => {
  const demoDiff = Number(!!a.demo) - Number(!!b.demo);
  if (demoDiff !== 0) return demoDiff;
  return Number(!!b.featured) - Number(!!a.featured);
});
const categories = ['all', ...new Set(sortedProjects.map((project) => project.type))];
---

<BaseLayout
  currentPath="/portafolio"
  title="Portafolio | CODEDMO"
  description="Casos y demos de productos web, portales y e-commerce desarrollados por CODEDMO."
  canonical={canonical}
  keywords={['portafolio web', 'proyectos React', 'e-commerce Guatemala', 'casos de desarrollo']}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Portafolio CODEDMO',
    url: canonical,
    description: 'Colección de proyectos desarrollados por CODEDMO.',
  }}
>
  <section class="page-fill relative overflow-hidden bg-slate-950 py-20">
    <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.08)_1px,transparent_1px)] bg-[size:30px_30px]" aria-hidden="true"></div>
    <div class="absolute right-1/4 top-20 h-96 w-96 rounded-full bg-blue-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-black text-white sm:text-6xl">
          Portafolio de <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">Desarrollo</span>
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-300">
          Selección de experiencias web y comerciales construidas con foco en claridad, velocidad y
          conversión.
        </p>
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-3" data-portfolio-filters>
        {
          categories.map((category) => (
            <button
              type="button"
              data-filter={category}
              class:list={[
                'rounded-full border px-4 py-2 text-sm font-medium transition-colors duration-300',
                category === 'all'
                  ? 'border-blue-400/40 bg-blue-500/15 text-white'
                  : 'border-white/10 bg-white/5 text-slate-300 hover:bg-white/10 hover:text-white',
              ]}
            >
              {category === 'all' ? 'Todos' : category}
            </button>
          ))
        }
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-2 xl:grid-cols-3" data-portfolio-grid>
        {
          sortedProjects.map((project) => (
            <article
              data-category={project.type}
              class="overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 backdrop-blur-sm transition-transform duration-300 hover:-translate-y-1"
            >
              <a href={project.link} target="_blank" rel="noreferrer" class="block">
                <div class="relative h-56 overflow-hidden">
                  <img src={project.image} alt={project.title} class="h-full w-full object-cover" loading="lazy" />
                  <div class="absolute right-4 top-4 rounded-full border border-white/15 bg-slate-950/80 px-3 py-1 text-xs font-semibold text-white">
                    {project.type}
                  </div>
                  {project.featured && (
                    <div class="absolute left-4 top-4 rounded-full bg-gradient-to-r from-blue-500 to-cyan-500 px-3 py-1 text-xs font-semibold text-white">
                      Destacado
                    </div>
                  )}
                </div>
              </a>
              <div class="flex h-[calc(100%-14rem)] flex-col p-6">
                <h2 class="text-2xl font-bold text-white">{project.title}</h2>
                <p class="mt-3 flex-1 text-sm leading-7 text-slate-300">{project.description}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {
                    project.tags.map((tag) => (
                      <span class="rounded-full border border-blue-400/20 bg-blue-500/10 px-3 py-1 text-xs font-medium text-blue-100">
                        {tag}
                      </span>
                    ))
                  }
                </div>
                <a
                  href={project.link}
                  target="_blank"
                  rel="noreferrer"
                  class="mt-6 inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-blue-600 to-cyan-600 px-5 py-3 text-sm font-semibold text-white transition-all duration-300 hover:scale-[1.02] hover:shadow-xl hover:shadow-blue-500/20"
                >
                  Ver proyecto
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const buttons = Array.from(document.querySelectorAll('[data-filter]'));
    const cards = Array.from(document.querySelectorAll('[data-category]'));

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        buttons.forEach((item) => {
          item.classList.remove('border-blue-400/40', 'bg-blue-500/15', 'text-white');
          item.classList.add('border-white/10', 'bg-white/5', 'text-slate-300');
        });
        button.classList.remove('border-white/10', 'bg-white/5', 'text-slate-300');
        button.classList.add('border-blue-400/40', 'bg-blue-500/15', 'text-white');

        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          const match = filter === 'all' || category === filter;
          card.classList.toggle('hidden', !match);
        });
      });
    });
  </script>
</BaseLayout>
