---
import Contact from '../components/contact';
import BaseLayout from '../layouts/BaseLayout.astro';

const canonical = 'https://codedmo.dev/contacto';
---

<BaseLayout
  currentPath="/contacto"
  title="Contacto | CODEDMO"
  description="Contacta a CODEDMO para evaluar tu proyecto, cotizar una solución o resolver dudas técnicas."
  canonical={canonical}
  keywords={['contacto CODEDMO', 'consulta técnica', 'cotización de software', 'desarrollo web Guatemala']}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contacto CODEDMO',
    url: canonical,
    description: 'Página de contacto de CODEDMO.',
  }}
>
  <section class="relative overflow-hidden bg-slate-900 py-20">
    <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[size:30px_30px]" aria-hidden="true"></div>
    <div class="absolute left-1/4 top-1/4 h-96 w-96 rounded-full bg-blue-500/10 blur-3xl" aria-hidden="true"></div>
    <div class="absolute bottom-0 right-1/4 h-80 w-80 rounded-full bg-cyan-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center">
        <h1 class="text-4xl font-black text-white sm:text-6xl">Conversemos</h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-slate-300">
          Comparte contexto, objetivos y restricciones. Te respondemos con criterio técnico, no con
          una plantilla genérica.
        </p>
      </div>

      <div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 backdrop-blur-sm sm:p-10">
        <Contact client:load />
      </div>
    </div>
  </section>
</BaseLayout>
