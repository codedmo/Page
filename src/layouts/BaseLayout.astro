---
import '../index.css';
import SpeedInsights from '@vercel/speed-insights/astro';
import FloatingWhatsApp from '../components/site/FloatingWhatsApp.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import {
  buildBreadcrumbSchema,
  buildOrganizationSchema,
  buildWebPageSchema,
  buildWebsiteSchema,
} from '../lib/seo';

interface Props {
  title: string;
  description: string;
  canonical: string;
  keywords?: string[];
  ogImage?: string;
  noIndex?: boolean;
  currentPath?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  keywords = [],
  ogImage = '/images/Hero.png',
  noIndex = false,
  currentPath = '/',
  structuredData,
} = Astro.props;

const siteUrl = 'https://codedmo.dev';
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const robots = noIndex
  ? 'noindex, nofollow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';
const baseSchemas = [
  buildWebsiteSchema(),
  buildOrganizationSchema(),
  buildWebPageSchema({
    pathname: currentPath,
    canonical,
    title,
    description,
  }),
  buildBreadcrumbSchema(currentPath, canonical),
];
const customSchemas = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const schemaItems = [...baseSchemas, ...customSchemas].filter((item, index, all) => {
  const itemRecord = item as Record<string, unknown>;
  const key =
    (typeof itemRecord['@id'] === 'string' && itemRecord['@id']) ||
    `${String(itemRecord['@type'] || 'Schema')}:${String(itemRecord.name || itemRecord.url || index)}`;

  return (
    all.findIndex((candidate) => {
      const candidateRecord = candidate as Record<string, unknown>;
      const candidateKey =
        (typeof candidateRecord['@id'] === 'string' && candidateRecord['@id']) ||
        `${String(candidateRecord['@type'] || 'Schema')}:${String(candidateRecord.name || candidateRecord.url || index)}`;

      return candidateKey === key;
    }) === index
  );
});
const alternateHref = canonical || `${siteUrl}${currentPath}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="author" content="CODEDMO Solutions" />
    <meta name="robots" content={robots} />
    <meta name="HandheldFriendly" content="True" />
    <meta name="MobileOptimized" content="320" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#0f172a" />
    <meta http-equiv="content-language" content="es" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="CODEDMO" />
    <meta property="og:locale" content="es_GT" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:site" content="@codedmo" />
    <meta name="googlebot" content={robots} />
    <meta name="application-name" content="CODEDMO" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={alternateHref} />
    <link rel="alternate" hreflang="es-GT" href={alternateHref} />
    <link rel="alternate" hreflang="x-default" href={alternateHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    {
      schemaItems.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
  </head>
  <body class="site-shell bg-slate-950 text-white antialiased">
    <div id="top"></div>
    <SiteHeader currentPath={currentPath} />
    <FloatingWhatsApp />
    <main class="site-main flex-1 pt-16">
      <div class="layout-slot flex min-h-full flex-1 flex-col">
        <slot />
      </div>
    </main>
    <SiteFooter />
    <SpeedInsights />
  </body>
</html>
